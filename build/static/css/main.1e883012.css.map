.wao-container {
  padding: 0;
  max-width: 100%;
  background: #f8fafc;
}

/* Header */
.wao-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 2rem;
  padding: 2rem;
  background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
  border: 1px solid #e2e8f0;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.wao-header-content h2 {
  font-size: 2rem;
  font-weight: 800;
  color: #1e293b;
  margin: 0 0 0.5rem 0;
  background: linear-gradient(135deg, #1e293b 0%, #0f766e 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.wao-subtitle {
  font-size: 0.9375rem;
  color: #64748b;
  margin: 0;
}

.wao-header-actions {
  display: flex;
  gap: 1rem;
  align-items: center;
}

.wao-select {
  padding: 0.625rem 0.875rem;
  border: 1px solid #cbd5e1;
  border-radius: 0;
  font-size: 0.875rem;
  color: #1e293b;
  background: white;
  cursor: pointer;
  transition: all 0.2s ease;
}

.wao-select:focus {
  outline: none;
  border-color: #0f766e;
  box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.1);
}

.wao-btn {
  padding: 0.625rem 1.25rem;
  border: none;
  border-radius: 0;
  font-size: 0.875rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
}

.wao-btn svg {
  width: 22px;
  height: 22px;
}

.wao-btn-primary {
  background: #0f766e;
  color: white;
}

.wao-btn-primary:hover {
  background: #0d615c;
  box-shadow: 0 4px 12px rgba(15, 118, 110, 0.3);
}

/* Summary cards */
.wao-summary-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 1rem;
  margin-bottom: 2rem;
}

.wao-summary-card {
  padding: 1.25rem;
  border: 1px solid rgba(148, 163, 184, 0.4);
  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.15);
  position: relative;
  overflow: hidden;
  background: #020617;
  color: #e5e7eb;
}

.wao-card-1 {
  background: radial-gradient(circle at top left, #0f766e, #020617);
}

.wao-card-2 {
  background: radial-gradient(circle at top left, #16a34a, #020617);
}

.wao-card-3 {
  background: radial-gradient(circle at top left, #22c55e, #020617);
}

.wao-card-4 {
  background: radial-gradient(circle at top left, #10b981, #020617);
}

.wao-summary-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0.75rem;
}

.wao-summary-label {
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: #cbd5f5;
}

.wao-summary-value {
  font-size: 1.7rem;
  font-weight: 800;
  margin-bottom: 0.25rem;
}

/* Smaller font size for first 3 cards */
.wao-card-1 .wao-summary-value,
.wao-card-2 .wao-summary-value,
.wao-card-3 .wao-summary-value {
  font-size: 1.3rem;
}

/* Force white color for card-3 value */
.wao-card-3 .wao-summary-value {
  color: white !important;
}

.wao-summary-value-small {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  font-size: 1rem;
  font-weight: 700;
}

.wao-summary-note {
  font-size: 0.8rem;
  color: #cbd5f5;
}

.wao-pill {
  padding: 0.15rem 0.6rem;
  font-size: 0.75rem;
  font-weight: 600;
  border-radius: 999px;
  border: 1px solid rgba(148, 163, 184, 0.6);
  background: rgba(15, 23, 42, 0.8);
}

/* Sections */
.wao-section {
  background: white;
  padding: 2rem;
  border: 1px solid #e2e8f0;
  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.08);
  margin-bottom: 2rem;
}

.wao-section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.5rem;
  padding-bottom: 1rem;
  border-bottom: 2px solid #e2e8f0;
}

.wao-section-header h3 {
  font-size: 1.25rem;
  font-weight: 700;
  margin: 0;
  color: #0f172a;
}

.wao-view-toggle {
  display: flex;
  gap: 0.5rem;
}

.wao-toggle-btn {
  padding: 0.5rem 1rem;
  border: 1px solid #cbd5e1;
  border-radius: 999px;
  background: white;
  color: #64748b;
  font-size: 0.875rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
}

.wao-toggle-btn:hover {
  background: #f8fafc;
  border-color: #0f766e;
}

.wao-toggle-btn.active {
  background: #0f766e;
  color: white;
  border-color: #0f766e;
}

/* Tables */
.wao-table-container {
  overflow-x: auto;
}

.wao-table {
  width: 100%;
  border-collapse: collapse;
}

.wao-table thead {
  background: #f8fafc;
}

.wao-table th {
  padding: 0.9rem 1rem;
  text-align: left;
  font-size: 0.8rem;
  font-weight: 600;
  color: #475569;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  border-bottom: 2px solid #e2e8f0;
  white-space: nowrap;
}

.wao-table td {
  padding: 0.8rem 1rem;
  font-size: 0.85rem;
  color: #0f172a;
  border-bottom: 1px solid #e2e8f0;
}

.wao-table tbody tr:hover {
  background: #f8fafc;
}

.wao-table tbody tr:last-child td {
  border-bottom: none;
}

/* Asset class bars */
.wao-asset-grid {
  display: flex;
  flex-direction: column;
}

.wao-asset-bars {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.wao-asset-row {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

.wao-asset-label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.85rem;
  font-weight: 600;
  color: #0f172a;
}

.wao-asset-bar {
  height: 0.65rem;
  background: #e2e8f0;
  border-radius: 999px;
  overflow: hidden;
}

.wao-asset-fill {
  height: 100%;
  background: linear-gradient(90deg, #0f766e 0%, #22c55e 100%);
}

.wao-asset-meta {
  font-size: 0.8rem;
  color: #64748b;
}

/* Responsive */
@media (max-width: 1024px) {
  .wao-header {
    flex-direction: column;
    gap: 1.5rem;
  }

  .wao-header-actions {
    width: 100%;
    flex-direction: column;
  }

  .wao-select,
  .wao-btn {
    width: 100%;
  }
}

@media (max-width: 768px) {
  .wao-section-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .wao-summary-grid {
    grid-template-columns: 1fr;
  }
}

