.wfp-container {
  padding: 0;
  max-width: 100%;
  background: #f8fafc;
}

/* Header */
.wfp-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 2rem;
  padding: 2rem;
  background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
  border: 1px solid #e2e8f0;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.wfp-header-content h2 {
  font-size: 2rem;
  font-weight: 800;
  color: #1e293b;
  margin: 0 0 0.5rem 0;
  background: linear-gradient(135deg, #1e293b 0%, #0f766e 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.wfp-subtitle {
  font-size: 0.9375rem;
  color: #64748b;
  margin: 0;
}

.wfp-header-actions {
  display: flex;
  gap: 1rem;
  align-items: center;
}

.wfp-select {
  padding: 0.625rem 0.875rem;
  border: 1px solid #cbd5e1;
  border-radius: 0;
  font-size: 0.875rem;
  color: #1e293b;
  background: white;
  cursor: pointer;
  transition: all 0.2s ease;
}

.wfp-select:focus {
  outline: none;
  border-color: #0f766e;
  box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.1);
}

.wfp-btn {
  padding: 0.625rem 1.25rem;
  border: none;
  border-radius: 0;
  font-size: 0.875rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
}

.wfp-btn svg {
  width: 22px;
  height: 22px;
}

.wfp-btn-primary {
  background: #0f766e;
  color: white;
}

.wfp-btn-primary:hover {
  background: #0d615c;
  box-shadow: 0 4px 12px rgba(15, 118, 110, 0.3);
}

/* Summary cards */
.wfp-summary-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 1rem;
  margin-bottom: 2rem;
}

.wfp-summary-card {
  padding: 1.25rem;
  border: 1px solid rgba(148, 163, 184, 0.4);
  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.15);
  position: relative;
  overflow: hidden;
  background: radial-gradient(circle at top left, rgba(148, 163, 184, 0.2), #020617);
  color: #e5e7eb;
}

.wfp-summary-card::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at top right, rgba(34, 197, 94, 0.3), transparent 60%);
  opacity: 0.6;
  pointer-events: none;
}

.wfp-summary-card > * {
  position: relative;
  z-index: 1;
}

.wfp-card-1 {
  background: radial-gradient(circle at top left, #0f766e, #020617);
}

.wfp-card-2 {
  background: radial-gradient(circle at top left, #16a34a, #020617);
}

.wfp-card-3 {
  background: radial-gradient(circle at top left, #2563eb, #020617);
}

.wfp-card-4 {
  background: radial-gradient(circle at top left, #f97316, #020617);
}

.wfp-summary-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0.75rem;
}

.wfp-summary-label {
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: #cbd5f5;
}

.wfp-summary-value {
  font-size: 1.7rem;
  font-weight: 800;
  margin-bottom: 0.25rem;
}

/* Smaller font size for first 2 cards */
.wfp-card-1 .wfp-summary-value,
.wfp-card-2 .wfp-summary-value {
  font-size: 1.3rem;
}

.wfp-summary-value-small {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  font-size: 1rem;
  font-weight: 700;
}

.wfp-summary-note {
  font-size: 0.8rem;
  color: #cbd5f5;
}

.wfp-pill {
  padding: 0.15rem 0.6rem;
  font-size: 0.75rem;
  font-weight: 600;
  border-radius: 999px;
  border: 1px solid rgba(148, 163, 184, 0.6);
}

.wfp-pill-positive {
  background: rgba(22, 163, 74, 0.15);
  color: #bbf7d0;
  border-color: rgba(22, 163, 74, 0.6);
}

.wfp-pill-negative {
  background: rgba(220, 38, 38, 0.15);
  color: #fecaca;
  border-color: rgba(220, 38, 38, 0.6);
}

/* Section */
.wfp-section {
  background: white;
  padding: 2rem;
  border: 1px solid #e2e8f0;
  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.08);
  margin-bottom: 2rem;
}

.wfp-section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.5rem;
  padding-bottom: 1rem;
  border-bottom: 2px solid #e2e8f0;
}

.wfp-section-header h3 {
  font-size: 1.25rem;
  font-weight: 700;
  margin: 0;
  color: #0f172a;
}

.wfp-view-toggle {
  display: flex;
  gap: 0.5rem;
}

.wfp-toggle-btn {
  padding: 0.5rem 1rem;
  border: 1px solid #cbd5e1;
  border-radius: 999px;
  background: white;
  color: #64748b;
  font-size: 0.875rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
}

.wfp-toggle-btn:hover {
  background: #f8fafc;
  border-color: #0f766e;
}

.wfp-toggle-btn.active {
  background: #0f766e;
  color: white;
  border-color: #0f766e;
}

/* Table */
.wfp-table-container {
  overflow-x: auto;
}

.wfp-table {
  width: 100%;
  border-collapse: collapse;
}

.wfp-table thead {
  background: #f8fafc;
}

.wfp-table th {
  padding: 0.9rem 1rem;
  text-align: left;
  font-size: 0.8rem;
  font-weight: 600;
  color: #475569;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  border-bottom: 2px solid #e2e8f0;
  white-space: nowrap;
}

.wfp-table td {
  padding: 0.8rem 1rem;
  font-size: 0.85rem;
  color: #0f172a;
  border-bottom: 1px solid #e2e8f0;
}

.wfp-table tbody tr:hover {
  background: #f8fafc;
}

.wfp-table tbody tr:last-child td {
  border-bottom: none;
}

.wfp-fund-cell {
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
}

.wfp-fund-code {
  font-size: 0.75rem;
  font-weight: 700;
  color: #475569;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.wfp-fund-name {
  font-size: 0.85rem;
  font-weight: 600;
  color: #111827;
}

/* Responsive */
@media (max-width: 1024px) {
  .wfp-header {
    flex-direction: column;
    gap: 1.5rem;
  }

  .wfp-header-actions {
    width: 100%;
    flex-direction: column;
  }

  .wfp-select,
  .wfp-btn {
    width: 100%;
  }
}

@media (max-width: 768px) {
  .wfp-section-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .wfp-summary-grid {
    grid-template-columns: 1fr;
  }
}

