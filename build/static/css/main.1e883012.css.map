/* Wealth Manager - Define Expenses (unique namespace: wmwm-define-expenses__) */

.wmwm-define-expenses__root {
  min-height: 100vh;
  padding: 2.25rem 2.5rem;
  background: radial-gradient(circle at top left, #ecfeff 0, #f8fafc 50%, #f1f5f9 100%);
  box-sizing: border-box;
}

.wmwm-define-expenses__header {
  margin-bottom: 1.75rem;
}

.wmwm-define-expenses__kicker {
  color: #64748b;
  font-size: 0.78rem;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  margin-bottom: 0.25rem;
}

.wmwm-define-expenses__title {
  margin: 0;
  font-size: 1.9rem;
  font-weight: 700;
  letter-spacing: -0.01em;
  color: #0f172a;
}

.wmwm-define-expenses__subtitle {
  margin: 0.5rem 0 0;
  color: #475569;
  font-size: 0.92rem;
}

.wmwm-define-expenses__container {
  max-width: 920px;
}

.wmwm-define-expenses__card {
  border-radius: 16px;
  overflow: hidden;
  border: 1px solid #dbeafe;
  box-shadow:
    0 18px 45px rgba(15, 23, 42, 0.08),
    0 1px 0 rgba(148, 163, 184, 0.2);
}

.wmwm-define-expenses__cardHeader {
  padding: 0.9rem 1.4rem;
  border-bottom: 1px solid #e2e8f0;
  background: #ffffff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #0f172a;
}

.wmwm-define-expenses__cardTitle {
  font-weight: 600;
  font-size: 0.95rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.wmwm-define-expenses__clearBtn {
  height: 32px;
  padding: 0 0.8rem;
  border-radius: 999px;
  border: 1px solid #e2e8f0;
  background: #f8fafc;
  color: #0f172a;
  cursor: pointer;
  font-size: 0.8rem;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
}

.wmwm-define-expenses__clearBtn:hover {
  background: rgba(15, 23, 42, 0.2);
}

.wmwm-define-expenses__body {
  padding: 1.4rem 1.4rem 1.25rem;
}

.wmwm-define-expenses__formGrid {
  display: grid;
  gap: 0.9rem;
}

.wmwm-define-expenses__row2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.9rem;
}

.wmwm-define-expenses__field {
  display: grid;
  gap: 6px;
  font-size: 0.85rem;
  color: #0f172a;
}

.wmwm-define-expenses__input,
.wmwm-define-expenses__select,
.wmwm-define-expenses__textarea {
  border: 1px solid #dbeafe;
  border-radius: 10px;
  outline: none;
  background: #f9fafb;
  transition: border-color 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
}

.wmwm-define-expenses__input,
.wmwm-define-expenses__select {
  height: 40px;
  padding: 0 0.85rem;
  font-size: 0.9rem;
}

.wmwm-define-expenses__select {
  background: #f9fafb;
}

.wmwm-define-expenses__textarea {
  padding: 0.8rem;
  resize: vertical;
  min-height: 90px;
  font-size: 0.9rem;
}

.wmwm-define-expenses__input:focus,
.wmwm-define-expenses__select:focus,
.wmwm-define-expenses__textarea:focus {
  border-color: #0f766e;
  background: #ffffff;
  box-shadow: 0 0 0 1px rgba(15, 118, 110, 0.3);
}

.wmwm-define-expenses__actions {
  display: flex;
  gap: 0.5rem;
  justify-content: flex-end;
  margin-top: 0.4rem;
}

.wmwm-define-expenses__saveBtn {
  height: 40px;
  padding: 0 1.4rem;
  border-radius: 999px;
  border: none;
  background: linear-gradient(135deg, #0f766e 0%, #14b8a6 50%, #22d3ee 100%);
  color: #ffffff;
  cursor: pointer;
  font-size: 0.9rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  box-shadow: 0 10px 22px rgba(15, 118, 110, 0.35);
}

.wmwm-define-expenses__saveBtn:hover {
  filter: brightness(1.04);
  box-shadow: 0 14px 30px rgba(15, 118, 110, 0.4);
}

.wmwm-define-expenses__note {
  color: #64748b;
  font-size: 0.8rem;
  margin-top: 0.4rem;
}

